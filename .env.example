# Copy to `.env` before running `docker compose up`.
#
# Docker forwards host-browser traffic through the bridge gateway, so setup from
# the host is treated as remote. Set a token here before the first start, then
# enter the same value in the "Setup token" field when creating the first
# account. The token is read at container start; change it and restart to apply.
AZOLLASENSE_SETUP_TOKEN=change-me

# Optional ESP32 serial settings.
# AZOLLASENSE_SERIAL_PORT=/dev/ttyACM0
# AZOLLASENSE_SERIAL_BAUD=115200

# Optional web push configuration.
# AZOLLASENSE_VAPID_PUBLIC_KEY=
# AZOLLASENSE_VAPID_PRIVATE_KEY=
# AZOLLASENSE_VAPID_SUBJECT=mailto:admin@example.com
